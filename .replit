modules = ["nodejs-20", "web", "bash", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_SECRET = "nextbase-dev-jwt-secret-key-2024-replit"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "admin123"
BACKEND_PORT = "3001"
NODE_ENV = "development"
ENABLE_2FA = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Backend && node_modules/.bin/ts-node src/index.ts"
waitForPort = 3001

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Frontend && node_modules/.bin/vite --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd Backend && node dist/index.js & cd Frontend && npx serve -s dist -l 5000"]
build = ["bash", "-c", "cd Frontend && npm install && npm run build && cd ../Backend && npm install && npm run build"]
