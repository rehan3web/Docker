# ── Database ──────────────────────────────────────────────────
DB_NAME=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ── Admin account ─────────────────────────────────────────────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string

# ── SSL / Let's Encrypt ───────────────────────────────────────
# Your real email address — used by Let's Encrypt for cert expiry notices.
# Must NOT be @example.com or any reserved domain. This is required.
ACME_EMAIL=you@yourdomain.com

# ── Two-Factor Authentication ─────────────────────────────────
# true  = TOTP required at every login (setup via Settings → 2FA after first login)
# false = password-only login (default; can be toggled any time)
ENABLE_2FA=false
